{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/ipc/v1/channel_259.schema.json",
  "title": "SKILL_IO Channel (259)",
  "description": "Messages between lanyte-core and external peers on the SKILL_IO channel. Covers skill lifecycle (install, list, describe, invoke, uninstall). Skill execution input/output are open JSON values — skill-specific schemas apply at the executor boundary, not at the IPC boundary.",
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "skill_id": {
      "type": "string",
      "description": "Reverse-domain skill identifier (e.g. dev.lanyte.echo)",
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]{0,254}[a-zA-Z0-9])?$",
      "maxLength": 256
    },
    "skill_summary": {
      "type": "object",
      "required": [
        "skill_id",
        "name",
        "version",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "author": {
          "type": "string",
          "maxLength": 256
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 20
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "title": "skill_install_request",
      "description": "Install a .lanyte-skill package into the executor. The package is base64-encoded. Requires admin privilege.",
      "required": [
        "type",
        "request_id",
        "package_b64"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_install_request"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "package_b64": {
          "type": "string",
          "description": "Base64-encoded .lanyte-skill package (gzipped tar)",
          "maxLength": 52428800
        },
        "force_reinstall": {
          "type": "boolean",
          "description": "If true, overwrite an existing skill with the same skill_id and version"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_install_response",
      "required": [
        "type",
        "request_id",
        "skill_id",
        "version",
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_install_response"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    {
      "type": "object",
      "title": "skill_uninstall_request",
      "description": "Remove an installed skill. Requires admin privilege.",
      "required": [
        "type",
        "request_id",
        "skill_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_uninstall_request"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_uninstall_response",
      "required": [
        "type",
        "request_id",
        "success"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_uninstall_response"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_invoke_request",
      "description": "Invoke an installed skill with a JSON input payload. The orchestrator schedules execution; the executor enforces fuel, memory, and time limits.",
      "required": [
        "type",
        "request_id",
        "skill_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_invoke_request"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        },
        "input": {
          "description": "Skill input payload — any JSON value; skill-specific schema applied at executor boundary"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000,
          "description": "Caller-requested timeout cap in milliseconds; executor enforces its own absolute limit"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_invoke_response",
      "required": [
        "type",
        "request_id",
        "skill_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_invoke_response"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        },
        "output": {
          "description": "Skill output payload — any JSON value"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fuel_used": {
          "type": "integer",
          "minimum": 0,
          "description": "WASM fuel units consumed"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_list_request",
      "required": [
        "type",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_list_request"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_list_response",
      "required": [
        "type",
        "request_id",
        "skills"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_list_response"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill_summary"
          },
          "maxItems": 1000
        }
      }
    },
    {
      "type": "object",
      "title": "skill_describe_request",
      "required": [
        "type",
        "request_id",
        "skill_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_describe_request"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_describe_response",
      "description": "Full skill manifest as returned by the WASM describe() call",
      "required": [
        "type",
        "request_id",
        "skill_id",
        "manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_describe_response"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "skill_id": {
          "$ref": "#/$defs/skill_id"
        },
        "manifest": {
          "$ref": "#/$defs/skill_summary"
        }
      }
    },
    {
      "type": "object",
      "title": "skill_error",
      "required": [
        "type",
        "request_id",
        "error_code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill_error"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "not_found",
            "already_installed",
            "invalid_package",
            "signature_invalid",
            "tier_violation",
            "execution_failed",
            "timeout",
            "fuel_exhausted",
            "memory_exceeded",
            "input_invalid",
            "output_invalid",
            "permission_denied",
            "rate_limited"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  ]
}
