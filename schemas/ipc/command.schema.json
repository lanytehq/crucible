{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/ipc/v1/command.schema.json",
  "title": "COMMAND Channel (1)",
  "description": "Generic structured command/response channel. Used for operations that do not map to a dedicated application channel (MAIL, PROXY, ADMIN, SKILL_IO). Command payloads are typed by the 'command' field; args are an open JSON object validated by the command handler rather than at the IPC boundary.",
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "title": "invoke",
      "description": "Execute a named command on the remote side. Args are command-specific and validated by the handler.",
      "required": ["type", "request_id", "command"],
      "additionalProperties": false,
      "properties": {
        "type":       { "const": "invoke" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "command":    { "type": "string", "minLength": 1, "maxLength": 256, "description": "Dot-namespaced command name (e.g. core.reload_policy, skill.purge_cache)" },
        "args":       {
          "type": "object",
          "description": "Command arguments — open object, schema is command-specific",
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "title": "invoke_result",
      "description": "Result of a successful command invocation.",
      "required": ["type", "request_id", "command"],
      "additionalProperties": false,
      "properties": {
        "type":       { "const": "invoke_result" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "command":    { "type": "string", "maxLength": 256 },
        "result":     {
          "type": "object",
          "description": "Command result payload — open object, command-specific",
          "additionalProperties": true
        }
      }
    },
    {
      "type": "object",
      "title": "invoke_error",
      "required": ["type", "request_id", "command", "error_code", "message"],
      "additionalProperties": false,
      "properties": {
        "type":       { "const": "invoke_error" },
        "request_id": { "$ref": "#/$defs/request_id" },
        "command":    { "type": "string", "maxLength": 256 },
        "error_code": {
          "type": "string",
          "enum": ["unknown_command", "invalid_args", "permission_denied", "internal_error", "rate_limited"]
        },
        "message":   { "type": "string", "maxLength": 1024 },
        "retryable": { "type": "boolean" }
      }
    }
  ]
}
