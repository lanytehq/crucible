{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/common/chanvoy-daemon-rpc/v0/wait_channels_v1.result.schema.json",
  "title": "Chanvoy wait_channels_v1 Successful Result",
  "description": "A successful first-match result. Clean deadman and hard failures are JSON-RPC errors, not successful results.",
  "type": "object",
  "required": [
    "mode",
    "channels",
    "matched_channel",
    "messages"
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "required": [
        "team",
        "channel"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "username",
        "message",
        "create_at",
        "root_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "create_at": {
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level posts carry their own id; replies carry the thread root id."
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "mode": {
      "type": "string",
      "const": "fan_in"
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selector"
      },
      "description": "Canonical selectors for every successfully armed channel."
    },
    "matched_channel": {
      "$ref": "#/$defs/selector",
      "description": "Canonical winning selector. It must equal exactly one channels entry; this relation is a runtime invariant."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "additionalProperties": false
}
