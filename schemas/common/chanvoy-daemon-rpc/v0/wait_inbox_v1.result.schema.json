{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/common/chanvoy-daemon-rpc/v0/wait_inbox_v1.result.schema.json",
  "title": "Chanvoy wait_inbox_v1 Successful Result",
  "description": "A successful first-match inbox wait. peer_username, matched_post_id, and next_inbox_cursor are three labeled fields. The cursor must not look like a post id. Clean deadman and hard failures are JSON-RPC errors, not successful results.",
  "type": "object",
  "required": [
    "peer_username",
    "dm_name",
    "matched_post_id",
    "next_inbox_cursor",
    "messages"
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "username",
        "message",
        "create_at",
        "root_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "create_at": {
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level posts carry their own id; replies carry the thread root id."
        }
      },
      "additionalProperties": false
    },
    "inbox-cursor": {
      "type": "string",
      "minLength": 8,
      "maxLength": 32768,
      "pattern": "^inv1\\.",
      "description": "Opaque versioned inbox cursor. Not a Mattermost post id. Encoded form is capped at 32 KiB. The decoded catalog is never a wire field."
    },
    "post-id": {
      "type": "string",
      "pattern": "^[a-z0-9]{26}$"
    }
  },
  "properties": {
    "peer_username": {
      "type": "string",
      "minLength": 1,
      "description": "Username of the peer who sent the matching DM."
    },
    "dm_name": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical Mattermost DM channel name ({uid}__{uid})."
    },
    "matched_post_id": {
      "$ref": "#/$defs/post-id",
      "description": "Id of the matching post. Distinct from next_inbox_cursor."
    },
    "next_inbox_cursor": {
      "$ref": "#/$defs/inbox-cursor",
      "description": "Sink-acknowledged inbox cursor for a later --after. Not a post id."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "replaced_wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "additionalProperties": false
}
