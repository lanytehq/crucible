{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/common/chanvoy-daemon-rpc/v0/wait_inbox_follow_v2.event.schema.json",
  "title": "Chanvoy wait_inbox_follow_v2 Stream Event",
  "description": "One JSONL record from a coalescing process-held inbox wait. This is not wait_follow_v2.event: an inbox cursor spans direct channels. Each ordered burst item carries its own peer and canonical DM labels because one burst may span multiple direct channels. Cursor advancement is sink-acknowledged.",
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "username",
        "message",
        "create_at",
        "root_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "create_at": {
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level posts carry their own id; replies carry the thread root id."
        }
      },
      "additionalProperties": false
    },
    "schema-name": {
      "type": "string",
      "const": "wait_inbox_follow_v2.event"
    },
    "wait-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "post-id": {
      "type": "string",
      "pattern": "^[a-z0-9]{26}$"
    },
    "inbox-cursor": {
      "type": "string",
      "minLength": 8,
      "maxLength": 32768,
      "pattern": "^inv1\\.",
      "description": "Opaque versioned inbox cursor. Not a Mattermost post id. Encoded form is capped at 32 KiB. The decoded catalog is never a wire field."
    },
    "peer": {
      "type": "string",
      "minLength": 1
    },
    "matched-message": {
      "type": "object",
      "required": [
        "peer_username",
        "dm_name",
        "message"
      ],
      "properties": {
        "peer_username": {
          "$ref": "#/$defs/peer"
        },
        "dm_name": {
          "$ref": "#/$defs/peer"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "armed"
        },
        "replaced_wait_id": {
          "$ref": "#/$defs/wait-id"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "matched_post_id",
        "next_inbox_cursor",
        "truncated",
        "messages"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "backlog"
        },
        "matched_post_id": {
          "$ref": "#/$defs/post-id",
          "description": "The id of the final matched message in this ordered burst."
        },
        "next_inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        },
        "truncated": {
          "type": "boolean",
          "const": false,
          "description": "A 32-message cap flushes the burst instead of dropping admitted messages."
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/matched-message"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "matched_post_id",
        "next_inbox_cursor",
        "truncated",
        "messages"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "live"
        },
        "matched_post_id": {
          "$ref": "#/$defs/post-id",
          "description": "The id of the final matched message in this ordered burst."
        },
        "next_inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        },
        "truncated": {
          "type": "boolean",
          "const": false
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/matched-message"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "deadman"
        },
        "inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "canceled"
        },
        "inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "replaced_by_wait_id"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "replaced"
        },
        "replaced_by_wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "reason_code"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "failed"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "provider_failed",
            "provider_overflow",
            "provider_outage",
            "cursor_uncertain",
            "capacity",
            "provider_degraded",
            "ownership_lost",
            "daemon_shutdown"
          ]
        },
        "inbox_cursor": {
          "$ref": "#/$defs/inbox-cursor"
        }
      },
      "additionalProperties": false
    }
  ]
}
