{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/common/chanvoy-daemon-rpc/v0/wait_follow_v1.event.schema.json",
  "title": "Chanvoy wait_follow_v1 Stream Event",
  "description": "One JSONL record from a process-held, single-channel Chanvoy wait. Records are ordered: one armed receipt, zero or more backlog/live bursts, then at most one terminal record.",
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "username",
        "message",
        "create_at",
        "root_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "create_at": {
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level posts carry their own id; replies carry the thread root id."
        }
      },
      "additionalProperties": false
    },
    "schema-name": {
      "type": "string",
      "const": "wait_follow_v1.event"
    },
    "wait-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Opaque id of the held waiter. Every record in one stream carries the same value."
    },
    "matched-channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 513,
      "description": "Optional requested single-channel selector. Arrays and per-arm selectors are not valid in v1."
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "armed"
        },
        "matched_channel": {
          "$ref": "#/$defs/matched-channel"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "tip",
        "truncated",
        "messages"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "backlog",
            "live"
          ]
        },
        "tip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exclusive baseline for a later follow. It equals the id of the final message in this record."
        },
        "truncated": {
          "type": "boolean",
          "description": "True when additional eligible messages remain for a later record in this same held follow; messages are not discarded."
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "matched_channel": {
          "$ref": "#/$defs/matched-channel"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "deadman"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "canceled"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "replaced_by_wait_id"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "replaced"
        },
        "replaced_by_wait_id": {
          "$ref": "#/$defs/wait-id"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "wait_id",
        "mode",
        "reason_code"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/schema-name"
        },
        "wait_id": {
          "$ref": "#/$defs/wait-id"
        },
        "mode": {
          "type": "string",
          "const": "failed"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "provider_failed",
            "provider_overflow",
            "provider_outage",
            "cursor_uncertain",
            "provider_degraded",
            "ownership_lost",
            "daemon_shutdown"
          ],
          "description": "Stable, locally constructed terminal class. Raw provider details are never stream data."
        }
      },
      "additionalProperties": false
    }
  ]
}
