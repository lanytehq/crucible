{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/common/chanvoy-daemon-rpc/v0/wait_dm_v1.result.schema.json",
  "title": "Chanvoy wait_dm_v1 Successful Result",
  "description": "A successful first-match DM wait. Callers must not reverse a channel UUID: peer_username and canonical dm_name are required. Clean deadman and hard failures are JSON-RPC errors, not successful results.",
  "type": "object",
  "required": [
    "peer_username",
    "dm_name",
    "channel",
    "messages"
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "username",
        "message",
        "create_at",
        "root_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "create_at": {
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "description": "Top-level posts carry their own id; replies carry the thread root id."
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "peer_username": {
      "type": "string",
      "minLength": 1,
      "description": "Exact requested peer username."
    },
    "dm_name": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical Mattermost DM channel name ({uid}__{uid})."
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "description": "Echo of the canonical DM name used as the wait selector after admission."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "replaced_wait_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "additionalProperties": false
}
