{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/mail/v0/delegation.schema.json",
  "title": "Mail Delegation v0",
  "description": "Grant of bounded mail authority from an account principal to a delegate. Absence of a matching allow grant is a denial. A grant that permits a send-class operation requires recipient, untrusted-content and approval rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "delegation_id",
    "account_ref",
    "principal",
    "delegate",
    "grants",
    "valid_from",
    "expires_at",
    "revoked_at"
  ],
  "$defs": {
    "delegation-id": {
      "type": "string",
      "description": "Opaque delegation identifier; same value space as the MAIL channel delegation_id.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "safe-token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "op": {
      "type": "string",
      "description": "Mail operation. Superset of MAIL channel operations.",
      "enum": [
        "search",
        "read",
        "list_folders",
        "draft",
        "mark",
        "move",
        "archive",
        "trash",
        "send",
        "reply",
        "forward"
      ]
    },
    "address-pattern": {
      "type": "string",
      "description": "Exact address or wildcard pattern such as *@example.com.",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[^\\s@]+@[^\\s@]+$"
    },
    "mailbox-selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "role",
            "name"
          ]
        },
        "value": {
          "$ref": "#/$defs/safe-token"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "ref": {
          "$ref": "#/$defs/safe-token"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ops",
        "effect"
      ],
      "properties": {
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/op"
          }
        },
        "effect": {
          "enum": [
            "allow",
            "require_approval",
            "deny"
          ]
        },
        "mailboxes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mailbox-selector"
          }
        },
        "senders": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/address-pattern"
          }
        }
      }
    },
    "nullable-datetime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "mail.delegation.v0"
    },
    "delegation_id": {
      "$ref": "#/$defs/delegation-id"
    },
    "account_ref": {
      "$ref": "#/$defs/safe-token",
      "description": "Opaque reference to the delegated account; resolved by the enforcing peer."
    },
    "principal": {
      "$ref": "#/$defs/identity"
    },
    "delegate": {
      "$ref": "#/$defs/identity"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "recipients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_external"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/address-pattern"
          }
        },
        "new_external": {
          "enum": [
            "require_approval",
            "deny"
          ]
        },
        "max_per_message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "untrusted_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_senders",
        "tainted_send"
      ],
      "properties": {
        "trusted_senders": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/address-pattern"
          }
        },
        "tainted_send": {
          "enum": [
            "require_approval",
            "deny"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sends_per_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sends_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token_ttl_secs"
      ],
      "properties": {
        "token_ttl_secs": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "$ref": "#/$defs/nullable-datetime"
    },
    "revoked_at": {
      "$ref": "#/$defs/nullable-datetime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grants": {
            "contains": {
              "type": "object",
              "required": [
                "ops",
                "effect"
              ],
              "properties": {
                "effect": {
                  "enum": [
                    "allow",
                    "require_approval"
                  ]
                },
                "ops": {
                  "contains": {
                    "enum": [
                      "send",
                      "reply",
                      "forward"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "recipients",
          "untrusted_content",
          "approval"
        ]
      }
    }
  ]
}
