{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/mail/v0/policy-decision.schema.json",
  "title": "Mail Policy Decision v0",
  "description": "Authorization decision for one mail action request. Records the decision stage only; the provider effect is evidenced separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "request_id",
    "delegation_id",
    "op",
    "input_digest",
    "evaluator",
    "baseline_decision",
    "decision",
    "reasons",
    "signals",
    "decided_at"
  ],
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "description": "UUID v4 identifier (ADR-0006 request correlation form).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "delegation-id": {
      "type": "string",
      "description": "Opaque delegation identifier; same value space as the MAIL channel delegation_id.",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "safe-token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "sha256": {
      "type": "string",
      "description": "Lowercase hex SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "op": {
      "type": "string",
      "description": "Mail operation. Superset of MAIL channel operations.",
      "enum": [
        "search",
        "read",
        "list_folders",
        "draft",
        "mark",
        "move",
        "archive",
        "trash",
        "send",
        "reply",
        "forward"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "require_approval",
        "deny"
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "mail.policy-decision.v0"
    },
    "decision_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "request_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "delegation_id": {
      "$ref": "#/$defs/delegation-id"
    },
    "op": {
      "$ref": "#/$defs/op"
    },
    "input_digest": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the canonical action request (sorted keys, no insignificant whitespace)."
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "policy_digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safe-token"
        },
        "version": {
          "$ref": "#/$defs/safe-token"
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "baseline_decision": {
      "$ref": "#/$defs/decision",
      "description": "Decision from delegation rules and deterministic facts, before signals."
    },
    "decision": {
      "$ref": "#/$defs/decision",
      "description": "Final decision. Never weaker than baseline_decision."
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "code"
        ],
        "properties": {
          "source": {
            "enum": [
              "delegation",
              "rule",
              "signal",
              "default"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_digest",
        "expires_at"
      ],
      "properties": {
        "draft_digest": {
          "$ref": "#/$defs/sha256"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "prev_hash"
      ],
      "description": "Optional append-only log linkage (ADR-0008 hash-chain form).",
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "prev_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 64,
      "description": "Signal outcomes the evaluator considered. Identifiers and outcomes only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "id",
          "outcome"
        ],
        "properties": {
          "source": {
            "enum": [
              "detector",
              "assessor"
            ]
          },
          "id": {
            "$ref": "#/$defs/safe-token"
          },
          "outcome": {
            "enum": [
              "flag",
              "clear",
              "abstain",
              "error"
            ]
          }
        }
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
