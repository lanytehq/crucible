{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/memory/v0/kinds/agent-identity.schema.json",
  "title": "Agent Identity",
  "description": "Who a seat is and the estate it operates in. Maintainer-provisioned; read-only to agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "estate"
  ],
  "properties": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "scope"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bot_username": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "estate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org"
      ],
      "properties": {
        "org": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "coordination_team": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "home_channels": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        }
      }
    }
  }
}
