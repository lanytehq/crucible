{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/memory/v0/kinds/agent-cred-ref.schema.json",
  "title": "Agent Credential Reference",
  "description": "Where a credential lives and how to unlock it. Never holds the credential value. locator is a reference in the format of its store; values that look like credentials are rejected, but a reference format cannot prove that no secret was pasted, so writers and reviewers keep that duty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "store",
    "locator"
  ],
  "properties": {
    "store": {
      "enum": [
        "seclusor",
        "env",
        "keychain",
        "file"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Reference to the credential in its store; format depends on store."
    },
    "recipient": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(age1[02-9ac-hj-np-z]{58}|[a-z0-9][a-z0-9._-]{0,63}(@[a-z0-9.-]{1,63})?)$",
      "description": "Who can unlock it: an age recipient public key, or a seat or identity name. Never key material."
    },
    "env_names": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "maxLength": 64
      }
    },
    "unlock_reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "store": {
            "const": "seclusor"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63}){0,3}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "store": {
            "const": "env"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "store": {
            "const": "keychain"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._@-]{0,63})?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "store": {
            "const": "file"
          }
        }
      },
      "then": {
        "properties": {
          "locator": {
            "pattern": "^(~|\\$[A-Z][A-Z0-9_]{0,31})?(/[A-Za-z0-9._-]{1,64}){1,8}$"
          }
        }
      }
    }
  ]
}
