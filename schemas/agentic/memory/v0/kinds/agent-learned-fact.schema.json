{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/memory/v0/kinds/agent-learned-fact.schema.json",
  "title": "Agent Learned Fact",
  "description": "One fact a seat should carry forward. One fact per entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement",
    "confidence",
    "source"
  ],
  "properties": {
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "confidence": {
      "enum": [
        "observed",
        "told",
        "inferred"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "review_by": {
      "type": "string",
      "format": "date",
      "maxLength": 10
    },
    "topics": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      }
    }
  }
}
