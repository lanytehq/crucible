{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/memory/v0/kinds/agent-handoff.schema.json",
  "title": "Agent Handoff",
  "description": "Work passed from one seat or session to another. An acknowledgement is a later revision written by the receiving seat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "to",
    "summary",
    "state"
  ],
  "properties": {
    "to": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\.[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "<role>.<scope> of the receiving seat."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "next_actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "state": {
      "enum": [
        "open",
        "acknowledged",
        "closed"
      ]
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "context_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "open"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "acknowledged_at"
          ]
        }
      },
      "else": {
        "required": [
          "acknowledged_at"
        ]
      }
    }
  ]
}
