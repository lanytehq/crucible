{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/gearwit/v0/handled-cursor.schema.json",
  "title": "Gearwit Handled Cursor v0",
  "description": "Seat acknowledgement that events through a delivered cursor have been handled. Separate from the waiter-link union. Uses stable signal identity, not retry-specific delivery identity.",
  "oneOf": [
    {
      "$ref": "#/$defs/handled-cursor-request"
    },
    {
      "$ref": "#/$defs/handled-cursor-accepted"
    },
    {
      "$ref": "#/$defs/handled-cursor-rejected"
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "safe-token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F]+$"
    },
    "seat-id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "reject-code": {
      "type": "string",
      "enum": [
        "unknown_arm",
        "stale_generation",
        "seat_mismatch",
        "unknown_signal",
        "ack_before_delivery",
        "cursor_not_member",
        "cursor_beyond_delivered",
        "stale_cursor"
      ]
    },
    "handled-cursor-request": {
      "type": "object",
      "required": [
        "schema",
        "type",
        "request_id",
        "arm_id",
        "generation",
        "seat_id",
        "signal_id",
        "cursor",
        "observed_at"
      ],
      "properties": {
        "schema": {
          "const": "gearwit.interrupt.handled-cursor.v0"
        },
        "type": {
          "const": "handled_cursor_request"
        },
        "request_id": {
          "$ref": "#/$defs/ulid"
        },
        "arm_id": {
          "$ref": "#/$defs/ulid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "seat_id": {
          "$ref": "#/$defs/seat-id"
        },
        "signal_id": {
          "$ref": "#/$defs/ulid"
        },
        "cursor": {
          "$ref": "#/$defs/safe-token"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "handled-cursor-accepted": {
      "type": "object",
      "required": [
        "schema",
        "type",
        "request_id",
        "arm_id",
        "generation",
        "signal_id",
        "cursor",
        "accepted_at"
      ],
      "properties": {
        "schema": {
          "const": "gearwit.interrupt.handled-cursor.v0"
        },
        "type": {
          "const": "handled_cursor_accepted"
        },
        "request_id": {
          "$ref": "#/$defs/ulid"
        },
        "arm_id": {
          "$ref": "#/$defs/ulid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "signal_id": {
          "$ref": "#/$defs/ulid"
        },
        "cursor": {
          "$ref": "#/$defs/safe-token"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "handled-cursor-rejected": {
      "type": "object",
      "required": [
        "schema",
        "type",
        "request_id",
        "code",
        "observed_at"
      ],
      "properties": {
        "schema": {
          "const": "gearwit.interrupt.handled-cursor.v0"
        },
        "type": {
          "const": "handled_cursor_rejected"
        },
        "request_id": {
          "$ref": "#/$defs/ulid"
        },
        "code": {
          "$ref": "#/$defs/reject-code"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
