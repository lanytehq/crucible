{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/agentic/mission/v0/mission-record.schema.json",
  "title": "Lanyte Mission Record",
  "description": "Durable mission state above replaceable harness attempts. Principals, operating role, and execution attempts remain distinct. Consumers must enforce the companion semantic rules.",
  "type": "object",
  "required": [
    "mission_schema",
    "mission_id",
    "revision",
    "goal",
    "policy_id",
    "created_at",
    "updated_at",
    "initiator",
    "authorizer",
    "authorization_ref",
    "supervisor",
    "operating_role",
    "phase",
    "terminal_reason",
    "deadline_at",
    "lease_policy",
    "budget_policy",
    "harness_selection",
    "recovery_policy",
    "recovery_point_ref",
    "attempts",
    "current_attempt_id",
    "evidence_chain_id",
    "terminal_entry_hash"
  ],
  "properties": {
    "mission_schema": {
      "const": "https://schemas.3leaps.dev/agentic/mission/v0/mission-record.schema.json"
    },
    "mission_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "policy_id": {
      "$ref": "#/$defs/opaque-id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "initiator": {
      "$ref": "#/$defs/principal"
    },
    "authorizer": {
      "$ref": "#/$defs/nullable-principal"
    },
    "authorization_ref": {
      "$ref": "#/$defs/nullable-ref",
      "description": "Reference to the immutable authorization decision. The authorizer principal alone is never treated as the decision."
    },
    "supervisor": {
      "$ref": "#/$defs/principal"
    },
    "operating_role": {
      "$ref": "#/$defs/operating-role"
    },
    "phase": {
      "$ref": "#/$defs/mission-phase"
    },
    "terminal_reason": {
      "$ref": "#/$defs/nullable-terminal-reason"
    },
    "deadline_at": {
      "$ref": "#/$defs/nullable-timestamp"
    },
    "lease_policy": {
      "$ref": "#/$defs/lease-policy"
    },
    "budget_policy": {
      "$ref": "#/$defs/budget-policy"
    },
    "harness_selection": {
      "$ref": "#/$defs/nullable-harness-selection"
    },
    "recovery_policy": {
      "type": "string",
      "enum": [
        "resume_or_relaunch",
        "resume_only",
        "ask_operator",
        "stand_down"
      ]
    },
    "recovery_point_ref": {
      "$ref": "#/$defs/nullable-ref"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "maxItems": 1024
    },
    "current_attempt_id": {
      "$ref": "#/$defs/nullable-uuid-v4"
    },
    "evidence_chain_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "terminal_entry_hash": {
      "$ref": "#/$defs/nullable-sha256"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "created"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "revision": {
            "const": 0
          },
          "attempts": {
            "maxItems": 0
          },
          "current_attempt_id": {
            "type": "null"
          },
          "authorizer": {
            "type": "null"
          },
          "authorization_ref": {
            "type": "null"
          },
          "terminal_reason": {
            "type": "null"
          },
          "terminal_entry_hash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "active",
              "waiting"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "current_attempt_id": {
            "$ref": "#/$defs/uuid-v4"
          },
          "authorizer": {
            "$ref": "#/$defs/principal"
          },
          "authorization_ref": {
            "type": "string"
          },
          "terminal_reason": {
            "type": "null"
          },
          "terminal_entry_hash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "completed",
              "cancelled",
              "failed",
              "deadline_exceeded",
              "budget_exhausted"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "current_attempt_id": {
            "type": "null"
          },
          "terminal_reason": {
            "$ref": "#/$defs/terminal-reason"
          },
          "terminal_entry_hash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullable-uuid-v4": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/uuid-v4"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable-timestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timestamp"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable-sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "nullable-ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      ]
    },
    "operating-role": {
      "type": "object",
      "required": [
        "role",
        "scope"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9/_-]{0,255}$"
        }
      },
      "additionalProperties": false
    },
    "attestation-ref": {
      "type": "object",
      "required": [
        "issuer",
        "session_id",
        "jti",
        "context_sha256",
        "token_sha256",
        "verification_policy_sha256",
        "trust_ref"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "jti": {
          "$ref": "#/$defs/uuid-v4"
        },
        "context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "token_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest for replay evidence. The bearer token itself is never persisted."
        },
        "verification_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trust_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "description": "Reference to independently verified attestation evidence. Never contains a raw token."
    },
    "principal": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "role",
        "scope",
        "attestation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "attested_session",
            "service"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "attestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/attestation-ref"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "attested_session"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "attestation": {
                "$ref": "#/$defs/attestation-ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "type": "null"
              },
              "scope": {
                "type": "null"
              },
              "attestation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "nullable-principal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/principal"
        }
      ]
    },
    "mission-phase": {
      "type": "string",
      "enum": [
        "created",
        "active",
        "waiting",
        "recovery_pending",
        "suspended",
        "completed",
        "cancelled",
        "failed",
        "deadline_exceeded",
        "budget_exhausted"
      ]
    },
    "terminal-reason": {
      "type": "string",
      "enum": [
        "goal_satisfied",
        "operator_cancelled",
        "mission_deadline_exceeded",
        "budget_exhausted",
        "policy_denied",
        "restore_exhausted",
        "required_driver_capability_unavailable",
        "internal_error"
      ]
    },
    "nullable-terminal-reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/terminal-reason"
        }
      ]
    },
    "lease-policy": {
      "type": "object",
      "required": [
        "enabled",
        "lease_seconds",
        "deadman_seconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lease_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "deadman_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "lease_seconds": {
                "type": "null"
              },
              "deadman_seconds": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "lease_seconds": {
                "type": "integer"
              },
              "deadman_seconds": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "budget-policy": {
      "type": "object",
      "required": [
        "wall_clock_seconds",
        "token_limit",
        "cost_micros",
        "action_limit"
      ],
      "properties": {
        "wall_clock_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "token_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cost_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "action_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "harness-selection": {
      "type": "object",
      "required": [
        "harness_id",
        "driver_id",
        "model",
        "workspace_ref",
        "environment_ref"
      ],
      "properties": {
        "harness_id": {
          "$ref": "#/$defs/opaque-id"
        },
        "driver_id": {
          "$ref": "#/$defs/opaque-id"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "workspace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "environment_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "nullable-harness-selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/harness-selection"
        }
      ]
    },
    "attempt-state": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting",
        "unresponsive",
        "cancelling",
        "completed",
        "cancelled",
        "replaced",
        "failed",
        "crashed",
        "timed_out",
        "lost"
      ]
    },
    "attempt-terminal-reason": {
      "type": "string",
      "enum": [
        "harness_completed",
        "operator_cancelled",
        "protocol_cancelled",
        "process_reaped",
        "spawn_failed",
        "identify_failed",
        "harness_crashed",
        "attempt_timed_out",
        "connectivity_lost",
        "replaced_by_successor",
        "outcome_unknown"
      ]
    },
    "nullable-attempt-terminal-reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/attempt-terminal-reason"
        }
      ]
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "ordinal",
        "generation",
        "fencing_token_sha256",
        "recovery_relation",
        "predecessor_attempt_id",
        "state",
        "driver_id",
        "harness_session_id",
        "started_at",
        "ended_at",
        "terminal_reason",
        "evidence_ref"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Server-owned monotonic generation used to reject observations from stale attempts."
        },
        "fencing_token_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the server-issued attempt fence. The raw operational capability is never persisted in the mission projection."
        },
        "recovery_relation": {
          "type": "string",
          "enum": [
            "initial",
            "resumes",
            "relaunches"
          ]
        },
        "predecessor_attempt_id": {
          "$ref": "#/$defs/nullable-uuid-v4"
        },
        "state": {
          "$ref": "#/$defs/attempt-state"
        },
        "driver_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/opaque-id"
            }
          ]
        },
        "harness_session_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512,
          "description": "Harness-reported identifier. Never identity or authority proof."
        },
        "started_at": {
          "$ref": "#/$defs/nullable-timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/nullable-timestamp"
        },
        "terminal_reason": {
          "$ref": "#/$defs/nullable-attempt-terminal-reason"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nullable-ref"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recovery_relation": {
                "const": "initial"
              }
            },
            "required": [
              "recovery_relation"
            ]
          },
          "then": {
            "properties": {
              "predecessor_attempt_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_relation": {
                "enum": [
                  "resumes",
                  "relaunches"
                ]
              }
            },
            "required": [
              "recovery_relation"
            ]
          },
          "then": {
            "properties": {
              "predecessor_attempt_id": {
                "$ref": "#/$defs/uuid-v4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed",
                  "cancelled",
                  "replaced",
                  "failed",
                  "crashed",
                  "timed_out",
                  "lost"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "ended_at": {
                "$ref": "#/$defs/timestamp"
              },
              "terminal_reason": {
                "$ref": "#/$defs/attempt-terminal-reason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "starting",
                  "running",
                  "waiting",
                  "unresponsive",
                  "cancelling"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "ended_at": {
                "type": "null"
              },
              "terminal_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
