{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/agentic/mission/v0/driver-capabilities.schema.json",
  "title": "Lanyte Driver Capability Evidence",
  "description": "Immutable, time-bounded driver capability evidence. Availability and support fidelity are independent; consumers evaluate validity rather than trusting a stored valid flag.",
  "type": "object",
  "required": [
    "capabilities_schema",
    "report_id",
    "driver_id",
    "driver_version",
    "harness_kind",
    "observed_at",
    "expires_at",
    "availability",
    "capabilities",
    "validity_condition",
    "evidence_ref"
  ],
  "properties": {
    "capabilities_schema": {
      "const": "https://schemas.3leaps.dev/agentic/mission/v0/driver-capabilities.schema.json"
    },
    "report_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "driver_id": {
      "$ref": "#/$defs/opaque-id"
    },
    "driver_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "harness_kind": {
      "$ref": "#/$defs/opaque-id"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "temporarily_unavailable",
        "unknown"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "validity_condition": {
      "$ref": "#/$defs/validity-condition"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "fidelity",
        "observation",
        "enforcement",
        "replay",
        "limitation",
        "evidence_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "create",
            "identify",
            "heartbeat",
            "cancel",
            "resume",
            "close",
            "observe",
            "deliver_input",
            "approval_events",
            "tool_effect_events",
            "artifacts",
            "checkpoint",
            "usage_metering",
            "terminal_status",
            "local_process_termination"
          ]
        },
        "fidelity": {
          "type": "string",
          "enum": [
            "native",
            "mapped",
            "lossy",
            "unsupported"
          ]
        },
        "observation": {
          "type": "string",
          "enum": [
            "claim",
            "driver_observed",
            "kernel_observed",
            "resource_attested"
          ]
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "none",
            "request_only",
            "local_process_control",
            "protocol_confirmed"
          ]
        },
        "replay": {
          "type": "string",
          "enum": [
            "none",
            "idempotent",
            "cursor"
          ]
        },
        "limitation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "unsupported"
              }
            },
            "required": [
              "fidelity"
            ]
          },
          "then": {
            "properties": {
              "limitation": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "validity-condition": {
      "type": "object",
      "required": [
        "kind",
        "executable_version",
        "executable_sha256",
        "configuration_sha256",
        "platform",
        "probe_ref"
      ],
      "properties": {
        "kind": {
          "const": "executable-version-platform-match"
        },
        "executable_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "probe_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
