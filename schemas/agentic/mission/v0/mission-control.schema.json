{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/agentic/mission/v0/mission-control.schema.json",
  "title": "Lanyte Mission Control Payload",
  "description": "Strict handler request and result payloads carried inside the existing COMMAND channel. This is not a second wire envelope.",
  "type": "object",
  "required": [
    "control_schema",
    "kind",
    "request_id",
    "idempotency_key",
    "expected_revision",
    "operation",
    "body"
  ],
  "properties": {
    "control_schema": {
      "const": "https://schemas.3leaps.dev/agentic/mission/v0/mission-control.schema.json"
    },
    "kind": {
      "type": "string",
      "enum": [
        "request",
        "result"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$",
      "description": "Caller-stable replay key persisted for mutating operations. Reuse with different content is a conflict."
    },
    "expected_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Optimistic concurrency guard for operations on an existing mission."
    },
    "operation": {
      "type": "string",
      "enum": [
        "mission.create",
        "mission.show",
        "mission.list"
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.create"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/create-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.show"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/show-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.list"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/list-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "enum": [
              "mission.create",
              "mission.show"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/record-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.list"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/list-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.create"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "enum": [
              "mission.show",
              "mission.list"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "create-request": {
      "type": "object",
      "required": [
        "goal",
        "policy_id",
        "deadline_at",
        "recovery_policy"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "policy_id": {
          "$ref": "#/$defs/opaque-id"
        },
        "deadline_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "recovery_policy": {
          "type": "string",
          "enum": [
            "resume_or_relaunch",
            "resume_only",
            "ask_operator",
            "stand_down"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Authenticated initiator, authorizer, supervisor, and operating role are bound from verified server context, never accepted from the request body."
    },
    "show-request": {
      "type": "object",
      "required": [
        "mission_id"
      ],
      "properties": {
        "mission_id": {
          "$ref": "#/$defs/uuid-v4"
        }
      },
      "additionalProperties": false
    },
    "list-request": {
      "type": "object",
      "required": [
        "phases",
        "limit",
        "cursor"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "created",
              "active",
              "waiting",
              "recovery_pending",
              "suspended",
              "completed",
              "cancelled",
              "failed",
              "deadline_exceeded",
              "budget_exhausted"
            ]
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "record-result": {
      "type": "object",
      "required": [
        "record"
      ],
      "properties": {
        "record": {
          "$ref": "mission-record.schema.json"
        }
      },
      "additionalProperties": false
    },
    "list-result": {
      "type": "object",
      "required": [
        "records",
        "next_cursor"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "mission-record.schema.json"
          },
          "maxItems": 200
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    }
  }
}
