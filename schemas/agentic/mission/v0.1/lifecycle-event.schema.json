{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/agentic/mission/v0.1/lifecycle-event.schema.json",
  "title": "Lanyte Mission Lifecycle Event",
  "description": "Append-only mission lifecycle evidence with explicit provenance and a closed, typed payload.",
  "type": "object",
  "required": [
    "event_schema",
    "event_id",
    "mission_id",
    "sequence",
    "previous_entry_hash",
    "entry_hash",
    "occurred_at",
    "recorded_at",
    "event_type",
    "source",
    "payload"
  ],
  "properties": {
    "event_schema": {
      "const": "https://schemas.3leaps.dev/agentic/mission/v0.1/lifecycle-event.schema.json"
    },
    "event_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "mission_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_entry_hash": {
      "$ref": "#/$defs/nullable-sha256"
    },
    "entry_hash": {
      "$ref": "#/$defs/sha256"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "event_type": {
      "$ref": "#/$defs/event-type"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/mission-created"
        },
        {
          "$ref": "#/$defs/authorization-bound"
        },
        {
          "$ref": "#/$defs/mission-phase-changed"
        },
        {
          "$ref": "#/$defs/attempt-created"
        },
        {
          "$ref": "#/$defs/attempt-state-changed"
        },
        {
          "$ref": "#/$defs/driver-capability-evaluated"
        },
        {
          "$ref": "#/$defs/recovery-requested"
        },
        {
          "$ref": "#/$defs/recovery-point-recorded"
        },
        {
          "$ref": "#/$defs/mission-terminal"
        },
        {
          "$ref": "#/$defs/cancel-requested"
        },
        {
          "$ref": "#/$defs/protocol-cancel-attempted"
        },
        {
          "$ref": "#/$defs/process-termination-attempted"
        },
        {
          "$ref": "#/$defs/lease-started"
        },
        {
          "$ref": "#/$defs/lease-tick"
        },
        {
          "$ref": "#/$defs/restart-reconciled"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullable-uuid-v4": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/uuid-v4"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable-sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "event-type": {
      "type": "string",
      "enum": [
        "mission_created",
        "authorization_bound",
        "mission_phase_changed",
        "attempt_created",
        "attempt_state_changed",
        "driver_capability_evaluated",
        "recovery_requested",
        "recovery_point_recorded",
        "mission_terminal",
        "cancel_requested",
        "protocol_cancel_attempted",
        "process_termination_attempted",
        "lease_started",
        "lease_tick",
        "restart_reconciled"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "producer_version",
        "assurance",
        "evidence_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "kernel_observed",
            "verified_attestation",
            "driver_reported",
            "harness_reported",
            "operator_command"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assurance": {
          "type": "string",
          "enum": [
            "claim",
            "driver_observed",
            "kernel_observed",
            "resource_attested"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "verified_attestation",
                  "operator_command"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "principal-ref": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "attestation_ref"
      ],
      "properties": {
        "kind": {
          "const": "attested_session"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "mission-phase": {
      "type": "string",
      "enum": [
        "created",
        "active",
        "waiting",
        "recovery_pending",
        "suspended",
        "completed",
        "cancelled",
        "failed",
        "deadline_exceeded",
        "budget_exhausted"
      ]
    },
    "attempt-state": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "waiting",
        "unresponsive",
        "cancelling",
        "completed",
        "cancelled",
        "replaced",
        "failed",
        "crashed",
        "timed_out",
        "lost"
      ]
    },
    "terminal-reason": {
      "type": "string",
      "enum": [
        "goal_satisfied",
        "operator_cancelled",
        "mission_deadline_exceeded",
        "budget_exhausted",
        "policy_denied",
        "restore_exhausted",
        "required_driver_capability_unavailable",
        "internal_error"
      ]
    },
    "mission-created": {
      "type": "object",
      "required": [
        "type",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "mission_created"
        },
        "revision": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "authorization-bound": {
      "type": "object",
      "required": [
        "type",
        "authorizer",
        "authorization_ref"
      ],
      "properties": {
        "type": {
          "const": "authorization_bound"
        },
        "authorizer": {
          "$ref": "#/$defs/principal-ref"
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "mission-phase-changed": {
      "type": "object",
      "required": [
        "type",
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "mission_phase_changed"
        },
        "from": {
          "$ref": "#/$defs/mission-phase"
        },
        "to": {
          "$ref": "#/$defs/mission-phase"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "attempt-created": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "ordinal",
        "generation",
        "recovery_relation",
        "predecessor_attempt_id"
      ],
      "properties": {
        "type": {
          "const": "attempt_created"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_relation": {
          "type": "string",
          "enum": [
            "initial",
            "resumes",
            "relaunches"
          ]
        },
        "predecessor_attempt_id": {
          "$ref": "#/$defs/nullable-uuid-v4"
        }
      },
      "additionalProperties": false
    },
    "attempt-state-changed": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "from",
        "to",
        "reason",
        "cause"
      ],
      "properties": {
        "type": {
          "const": "attempt_state_changed"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "$ref": "#/$defs/attempt-state"
        },
        "to": {
          "$ref": "#/$defs/attempt-state"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "cause": {
          "type": "string",
          "enum": [
            "operator_cancel",
            "protocol_interrupt",
            "process_exit",
            "process_signal",
            "deadman_silence",
            "lease_expired",
            "connectivity_lost",
            "successor_replace",
            "harness_completed",
            "policy"
          ],
          "description": "Closed discriminator. deadman_silence may not fold crashed, timed_out, or lost."
        }
      },
      "additionalProperties": false
    },
    "driver-capability-evaluated": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "driver_id",
        "capability",
        "availability",
        "fidelity",
        "report_id"
      ],
      "properties": {
        "type": {
          "const": "driver_capability_evaluated"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "driver_id": {
          "$ref": "#/$defs/opaque-id"
        },
        "capability": {
          "type": "string",
          "enum": [
            "create",
            "identify",
            "heartbeat",
            "cancel",
            "resume",
            "close",
            "observe",
            "deliver_input",
            "approval_events",
            "tool_effect_events",
            "artifacts",
            "checkpoint",
            "usage_metering",
            "terminal_status",
            "local_process_termination"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "temporarily_unavailable",
            "unknown"
          ]
        },
        "fidelity": {
          "type": "string",
          "enum": [
            "native",
            "mapped",
            "lossy",
            "unsupported"
          ]
        },
        "report_id": {
          "$ref": "#/$defs/uuid-v4"
        }
      },
      "additionalProperties": false
    },
    "recovery-requested": {
      "type": "object",
      "required": [
        "type",
        "predecessor_attempt_id",
        "relation"
      ],
      "properties": {
        "type": {
          "const": "recovery_requested"
        },
        "predecessor_attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "relation": {
          "type": "string",
          "enum": [
            "resumes",
            "relaunches"
          ]
        }
      },
      "additionalProperties": false
    },
    "recovery-point-recorded": {
      "type": "object",
      "required": [
        "type",
        "recovery_point_ref"
      ],
      "properties": {
        "type": {
          "const": "recovery_point_recorded"
        },
        "recovery_point_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "mission-terminal": {
      "type": "object",
      "required": [
        "type",
        "phase",
        "reason",
        "terminal_entry_hash"
      ],
      "properties": {
        "type": {
          "const": "mission_terminal"
        },
        "phase": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "failed",
            "deadline_exceeded",
            "budget_exhausted"
          ]
        },
        "reason": {
          "$ref": "#/$defs/terminal-reason"
        },
        "terminal_entry_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "cancel-requested": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "lease_generation"
      ],
      "properties": {
        "type": {
          "const": "cancel_requested"
        },
        "attempt_id": {
          "$ref": "#/$defs/nullable-uuid-v4"
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lease_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "Operator cancel accepted. Not a terminal observation."
    },
    "protocol-cancel-attempted": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "lease_generation",
        "thread_id",
        "turn_id",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "protocol_cancel_attempted"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "outcome": {
          "type": "string",
          "enum": [
            "request_accepted",
            "interrupted",
            "unavailable",
            "failed",
            "timeout",
            "unrelated_completion"
          ],
          "description": "interrupted is the only protocol outcome that may fold cancelled. request_accepted is JSON-RPC accept of turn/interrupt only."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "interrupted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "thread_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "turn_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "process-termination-attempted": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "lease_generation",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "process_termination_attempted"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "kill_dispatched",
            "cleared",
            "survivors",
            "unknown"
          ],
          "description": "cleared is membership-verified tree reap. kill_dispatched, survivors, and unknown are non-success."
        }
      },
      "additionalProperties": false
    },
    "observation-source": {
      "type": "string",
      "enum": [
        "driver_event",
        "harness_event",
        "process_probe",
        "kernel_clock"
      ]
    },
    "lease-started": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "lease_generation",
        "lease_expires_at",
        "deadman_at",
        "observed_at",
        "observation_source"
      ],
      "properties": {
        "type": {
          "const": "lease_started"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "lease_generation": {
          "const": 1
        },
        "lease_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deadman_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_source": {
          "$ref": "#/$defs/observation-source"
        }
      },
      "additionalProperties": false,
      "description": "Durable initial lease anchor. The first tick prior tuple must match this receipt."
    },
    "lease-tick": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "kind",
        "prior_lease_generation",
        "result_lease_generation",
        "prior_lease_expires_at",
        "prior_deadman_at",
        "result_lease_expires_at",
        "result_deadman_at",
        "observed_at",
        "observation_source"
      ],
      "properties": {
        "type": {
          "const": "lease_tick"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "renewed",
            "deadman_fired",
            "expired"
          ]
        },
        "prior_lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "result_lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "prior_lease_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "prior_deadman_at": {
          "$ref": "#/$defs/timestamp"
        },
        "result_lease_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "result_deadman_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_source": {
          "$ref": "#/$defs/observation-source"
        }
      },
      "additionalProperties": false
    },
    "restart-reconciled": {
      "type": "object",
      "required": [
        "type",
        "attempt_id",
        "generation",
        "lease_generation",
        "overdue"
      ],
      "properties": {
        "type": {
          "const": "restart_reconciled"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1
        },
        "overdue": {
          "const": true,
          "description": "This receipt exists only for an applied overdue edge."
        }
      },
      "additionalProperties": false,
      "description": "First serve restart that applies an overdue lease emits this once. A second restart is a no-op and must not emit another receipt."
    }
  }
}
