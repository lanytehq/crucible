{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/agentic/mission/v0.1/mission-control.schema.json",
  "title": "Lanyte Mission Control Payload",
  "description": "Strict handler request and result payloads carried inside the existing COMMAND channel. This is not a second wire envelope.",
  "type": "object",
  "required": [
    "control_schema",
    "kind",
    "request_id",
    "idempotency_key",
    "expected_revision",
    "operation",
    "body",
    "request_fingerprint",
    "original_result_hash"
  ],
  "properties": {
    "control_schema": {
      "const": "https://schemas.3leaps.dev/agentic/mission/v0.1/mission-control.schema.json"
    },
    "kind": {
      "type": "string",
      "enum": [
        "request",
        "result"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/uuid-v4"
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$",
      "description": "Caller-stable replay key persisted for mutating operations. Reuse with different content is a conflict."
    },
    "request_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical mutating request content. Null on non-mutating operations."
    },
    "original_result_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the original mutating result. Null on first-write requests and on non-mutating operations."
    },
    "expected_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Optimistic concurrency guard for operations on an existing mission."
    },
    "operation": {
      "type": "string",
      "enum": [
        "mission.create",
        "mission.show",
        "mission.list",
        "mission.launch",
        "mission.observe",
        "mission.close",
        "mission.cancel"
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "mission.create",
              "mission.launch",
              "mission.close",
              "mission.cancel"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "request_fingerprint": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "request_fingerprint": {
            "type": "null"
          },
          "original_result_hash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "enum": [
              "mission.create",
              "mission.launch",
              "mission.close",
              "mission.cancel"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "original_result_hash": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "enum": [
              "mission.create",
              "mission.launch",
              "mission.close",
              "mission.cancel"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "original_result_hash": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.create"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/create-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.show"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/show-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.list"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/list-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.launch"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "$ref": "#/$defs/launch-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.observe"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          },
          "body": {
            "$ref": "#/$defs/show-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.close"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "$ref": "#/$defs/show-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          },
          "operation": {
            "const": "mission.cancel"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "$ref": "#/$defs/show-request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "enum": [
              "mission.create",
              "mission.show",
              "mission.launch"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/record-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.list"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/list-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.create"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.launch"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "enum": [
              "mission.show",
              "mission.list",
              "mission.observe"
            ]
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "expected_revision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.observe"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/observe-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.close"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "$ref": "#/$defs/close-result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "operation": {
            "const": "mission.cancel"
          }
        },
        "required": [
          "kind",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "$ref": "#/$defs/cancel-result"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid-v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "opaque-id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "create-request": {
      "type": "object",
      "required": [
        "goal",
        "policy_id",
        "deadline_at",
        "recovery_policy"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "policy_id": {
          "$ref": "#/$defs/opaque-id"
        },
        "deadline_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "recovery_policy": {
          "type": "string",
          "enum": [
            "resume_or_relaunch",
            "resume_only",
            "ask_operator",
            "stand_down"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Authenticated initiator, authorizer, supervisor, and operating role are bound from verified server context, never accepted from the request body."
    },
    "launch-request": {
      "type": "object",
      "required": [
        "mission_id",
        "workspace",
        "binary"
      ],
      "properties": {
        "mission_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Launch a pinned Codex App Server attempt on an existing created mission. Identity fields stay server-bound."
    },
    "show-request": {
      "type": "object",
      "required": [
        "mission_id"
      ],
      "properties": {
        "mission_id": {
          "$ref": "#/$defs/uuid-v4"
        }
      },
      "additionalProperties": false
    },
    "list-request": {
      "type": "object",
      "required": [
        "phases",
        "limit",
        "cursor"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "created",
              "active",
              "waiting",
              "recovery_pending",
              "suspended",
              "completed",
              "cancelled",
              "failed",
              "deadline_exceeded",
              "budget_exhausted"
            ]
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "record-result": {
      "type": "object",
      "required": [
        "record"
      ],
      "properties": {
        "record": {
          "$ref": "mission-record.schema.json"
        }
      },
      "additionalProperties": false
    },
    "observe-result": {
      "type": "object",
      "required": [
        "mission_id",
        "attempt_id",
        "events"
      ],
      "properties": {
        "mission_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/normalized-harness-event"
          }
        }
      },
      "additionalProperties": false
    },
    "cancel-result": {
      "type": "object",
      "required": [
        "record",
        "progress"
      ],
      "properties": {
        "record": {
          "$ref": "mission-record.schema.json"
        },
        "progress": {
          "$ref": "#/$defs/cancel-progress"
        }
      },
      "additionalProperties": false,
      "description": "Accepting cancel is not terminal success. Terminal cancelled is folded only after protocol-confirmed interrupt or membership-verified tree cleared."
    },
    "cancel-progress": {
      "type": "object",
      "required": [
        "requested",
        "protocol",
        "fallback"
      ],
      "properties": {
        "requested": {
          "const": true
        },
        "protocol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/protocol-cancel-progress"
            }
          ]
        },
        "fallback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fallback-cancel-progress"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "protocol-cancel-progress": {
      "type": "object",
      "required": [
        "outcome",
        "thread_id",
        "turn_id"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "request_accepted",
            "interrupted",
            "unavailable",
            "failed",
            "timeout",
            "unrelated_completion"
          ]
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "interrupted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "thread_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "turn_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "fallback-cancel-progress": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "kill_dispatched",
            "cleared",
            "survivors",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "close-result": {
      "type": "object",
      "required": [
        "mission_id",
        "attempt_id",
        "closed"
      ],
      "properties": {
        "mission_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "attempt_id": {
          "$ref": "#/$defs/uuid-v4"
        },
        "closed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "normalized-harness-event": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "started"
            },
            "occurred_at": {
              "$ref": "#/$defs/timestamp"
            },
            "attempt_id": {
              "$ref": "#/$defs/uuid-v4"
            },
            "harness_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "occurred_at",
            "attempt_id",
            "harness_session_id",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "tool_proposed"
            },
            "occurred_at": {
              "$ref": "#/$defs/timestamp"
            },
            "attempt_id": {
              "$ref": "#/$defs/uuid-v4"
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "occurred_at",
            "attempt_id",
            "tool",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "exited"
            },
            "occurred_at": {
              "$ref": "#/$defs/timestamp"
            },
            "attempt_id": {
              "$ref": "#/$defs/uuid-v4"
            },
            "success": {
              "type": "boolean"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "occurred_at",
            "attempt_id",
            "success",
            "detail"
          ],
          "additionalProperties": false
        }
      ]
    },
    "list-result": {
      "type": "object",
      "required": [
        "records",
        "next_cursor"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "mission-record.schema.json"
          },
          "maxItems": 200
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    }
  }
}
