{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/content/v0/kinds/agent-day.schema.json",
  "title": "Agent Day",
  "description": "Plan and outcomes for one working day.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "maxLength": 10
    },
    "plan": {
      "$ref": "https://schemas.lanyte.dev/agentic/content/v0/kinds/goal-item.schema.json#/$defs/goalList"
    },
    "outcomes": {
      "$ref": "https://schemas.lanyte.dev/agentic/content/v0/kinds/goal-item.schema.json#/$defs/goalList"
    },
    "carry_over": {
      "$ref": "https://schemas.lanyte.dev/agentic/content/v0/kinds/goal-item.schema.json#/$defs/goalList"
    }
  }
}
