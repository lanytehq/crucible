{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanyte.dev/agentic/content/v0/kinds/agent-week.schema.json",
  "title": "Agent Week",
  "description": "Goals and commitments for one ISO 8601 week (YYYY-Www, Monday start). Display in another week convention is a reader concern.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week",
    "goals"
  ],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$",
      "maxLength": 8
    },
    "goals": {
      "$ref": "https://schemas.lanyte.dev/agentic/content/v0/kinds/goal-item.schema.json#/$defs/goalList"
    },
    "commitments": {
      "$ref": "https://schemas.lanyte.dev/agentic/content/v0/kinds/goal-item.schema.json#/$defs/goalList"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "closed"
      ]
    }
  }
}
