# Vendored upstream files are pinned by sha256 in their MANIFEST.json and
# verified by check-content-v0; text formatters must not touch them.
config/classifiers/vendor/
schemas/vendor/
scripts/vendor/
# Release identity: committed public pins and fingerprint anchors are verified
# byte for byte by decernor (make release-check-anchors); never reformat them.
keys/
docs/security/*.asc
docs/security/*.pub
config/release/
